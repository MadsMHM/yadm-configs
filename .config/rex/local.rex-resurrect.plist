<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.rex-resurrect</string>
  <!-- Autosave Rex sessions every 15 min; see ~/.config/rex/resurrect.lua -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/madsskautrupjacobsen/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex</string>
    <string>--autostart=false</string>
    <string>do</string>
    <string>/Users/madsskautrupjacobsen/.config/rex/resurrect.lua</string>
    <string>cmd=save</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardErrorPath</key><string>/Users/madsskautrupjacobsen/.local/state/rex-resurrect/launchd.log</string>
</dict>
</plist>
